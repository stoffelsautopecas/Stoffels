{
  "name": "stoffels",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo e vitrine Stoffels Autopeças",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "verify": "node scripts/verify.mjs",
    "import:catalog": "python3 scripts/import_catalog.py",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "test:auth": "node --env-file=.env.local scripts/test-auth.mjs && node scripts/test-auth-ui.mjs",
    "shipping:estimate": "node --env-file=.env.local scripts/estimate-shipping.mjs",
    "test:shipping": "node scripts/test-shipping.mjs && node scripts/test-shipping-ui.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "type": "module"
}
